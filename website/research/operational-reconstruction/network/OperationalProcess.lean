import Std
set_option autoImplicit false

namespace OperationalNetwork.Process

/-- A laboratory supplies wire types, the two ways to wire *actual*
    processes, and the observable record of a closed experiment. The record
    may itself be a probability law on instrument transcripts. -/
structure Lab where
  Wire : Type
  unit : Wire
  pair : Wire → Wire → Wire
  Proc : Wire → Wire → Type
  after : ∀ {a b c}, Proc a b → Proc b c → Proc a c
  alongside : ∀ {a b c d}, Proc a b → Proc c d → Proc (pair a c) (pair b d)
  Record : Type
  read : Proc unit unit → Record

/-- All finite single-hole tests generated by this laboratory. A fixed
    ancilla may be a joint process; its internal representation is unrestricted. -/
inductive Test (L : Lab) : L.Wire → L.Wire → Type where
  | closed : Test L L.unit L.unit
  | thenDo {a b c} (other : L.Proc b c) (rest : Test L a c) : Test L a b
  | before {a b c} (other : L.Proc c a) (rest : Test L c b) : Test L a b
  | right {a b c d} (other : L.Proc c d) (rest : Test L (L.pair a c) (L.pair b d)) : Test L a b
  | left {a b c d} (other : L.Proc c d) (rest : Test L (L.pair c a) (L.pair d b)) : Test L a b

def observe {L : Lab} {a b} : Test L a b → L.Proc a b → L.Record
  | .closed, p => L.read p
  | .thenDo q t, p => observe t (L.after p q)
  | .before q t, p => observe t (L.after q p)
  | .right q t, p => observe t (L.alongside p q)
  | .left q t, p => observe t (L.alongside q p)

def equivalent (L : Lab) {a b} (p q : L.Proc a b) := ∀ t : Test L a b, observe t p = observe t q

def operational (L : Lab) (a b : L.Wire) : Setoid (L.Proc a b) where
  r := equivalent L
  iseqv := ⟨fun _ _ => rfl, fun h t => (h t).symm, fun h k t => (h t).trans (k t)⟩

abbrev Channel (L : Lab) (a b : L.Wire) := Quotient (operational L a b)
abbrev State (L : Lab) (a : L.Wire) := Channel L L.unit a

theorem afterCongr {L : Lab} {a b c} {p q : L.Proc a b} {u v : L.Proc b c}
    (h : equivalent L p q) (k : equivalent L u v) :
    equivalent L (L.after p u) (L.after q v) :=
  fun t => (h (.thenDo u t)).trans (k (.before q t))

theorem alongsideCongr {L : Lab} {a b c d} {p q : L.Proc a b} {u v : L.Proc c d}
    (h : equivalent L p q) (k : equivalent L u v) :
    equivalent L (L.alongside p u) (L.alongside q v) :=
  fun t => (h (.right u t)).trans (k (.left q t))

def compose {L : Lab} {a b c} : Channel L a b → Channel L b c → Channel L a c :=
  Quotient.lift₂ (fun p q => Quotient.mk _ (L.after p q))
    (fun _ _ _ _ hp hq => Quotient.sound (afterCongr hp hq))

def parallel {L : Lab} {a b c d} :
    Channel L a b → Channel L c d → Channel L (L.pair a c) (L.pair b d) :=
  Quotient.lift₂ (fun p q => Quotient.mk _ (L.alongside p q))
    (fun _ _ _ _ hp hq => Quotient.sound (alongsideCongr hp hq))

def outcome {L : Lab} {a b} (t : Test L a b) : Channel L a b → L.Record :=
  Quotient.lift (observe t) (fun _ _ h => h t)

theorem separated {L : Lab} {a b} (x y : Channel L a b) :
    (∀ t, outcome t x = outcome t y) ↔ x = y := by
  induction x using Quotient.inductionOn with
  | _ p =>
    induction y using Quotient.inductionOn with
    | _ q =>
      constructor
      · exact fun h => Quotient.sound h
      · intro h t; exact congrArg (outcome t) h

/-- Every substitutable identification preserving closed records is
    contained in operational equivalence. No tomography premise. -/
theorem coarsest {L : Lab} (R : ∀ {a b}, L.Proc a b → L.Proc a b → Prop)
    (closed : ∀ p q, R p q → L.read p = L.read q)
    (post : ∀ {a b c} {p q : L.Proc a b} (s : L.Proc b c), R p q → R (L.after p s) (L.after q s))
    (pre : ∀ {a b c} {p q : L.Proc a b} (s : L.Proc c a), R p q → R (L.after s p) (L.after s q))
    (right : ∀ {a b c d} {p q : L.Proc a b} (s : L.Proc c d), R p q → R (L.alongside p s) (L.alongside q s))
    (left : ∀ {a b c d} {p q : L.Proc a b} (s : L.Proc c d), R p q → R (L.alongside s p) (L.alongside s q))
    {a b} {p q : L.Proc a b} (h : R p q) : equivalent L p q := by
  intro t
  induction t with
  | closed => exact closed p q h
  | thenDo s _ ih => exact ih (post s h)
  | before s _ ih => exact ih (pre s h)
  | right s _ ih => exact ih (right s h)
  | left s _ ih => exact ih (left s h)

/-- If the record-level interchange law holds and two local choices agree
    after discarding their output, no remote probe on the parallel wire
    distinguishes them. The joint preparation may be correlated and the
    remaining circuit unrestricted. Conditioning on a local success flag
    would replace the discard and is not a premise of this theorem. -/
theorem noSignalAfterDiscard {L : Lab}
    (interchange : ∀ {a b c d e f} (p : L.Proc a b) (q : L.Proc b c)
      (r : L.Proc d e) (s : L.Proc e f),
      equivalent L (L.after (L.alongside p r) (L.alongside q s))
        (L.alongside (L.after p q) (L.after r s)))
    {a b d e f} (x y : L.Proc a b) (discard : L.Proc b L.unit)
    (localBlind : equivalent L (L.after x discard) (L.after y discard))
    (joint : L.Proc L.unit (L.pair a d)) (r : L.Proc d e) (s : L.Proc e f)
    (t : Test L L.unit (L.pair L.unit f)) :
    observe t (L.after joint (L.after (L.alongside x r) (L.alongside discard s))) =
    observe t (L.after joint (L.after (L.alongside y r) (L.alongside discard s))) := by
  let rest : Test L (L.pair a d) (L.pair L.unit f) := .before joint t
  have h := alongsideCongr localBlind (u:=L.after r s) (v:=L.after r s) (fun _ => rfl)
  exact ((interchange x discard r s rest).trans (h rest)).trans
    (interchange y discard r s rest).symm

/-- Concrete support-valued records. A closed circuit says whether its
    event is possible. The tests include all equality filters and all joint
    relations. This supplies no complex amplitudes or probabilities. -/
inductive Wire where | empty | cell | pair (l r : Wire)

def values (n : Nat) : Wire → Type
  | .empty => Unit
  | .cell => Fin n
  | .pair a b => values n a × values n b

def relLab (n : Nat) : Lab where
  Wire := Wire
  unit := .empty
  pair := .pair
  Proc a b := values n a → values n b → Prop
  after p q x z := ∃ y, p x y ∧ q y z
  alongside p q x y := p x.1 y.1 ∧ q x.2 y.2
  Record := Prop
  read p := p () ()

def prepare {n : Nat} (x : Fin n) : (relLab n).Proc .empty .cell := fun _ y => x = y
def detect {n : Nat} (z : Fin n) : (relLab n).Proc .cell .empty := fun y _ => y = z

/-- All filters are coarse-grainings of copying the actual classical
    symbol to the record. The same identity readout is used for all inputs. -/
theorem exactSymbol {n : Nat} (x z : Fin n) :
    observe (.thenDo (L:=relLab n) (detect z) .closed) (prepare x) ↔ x=z := by
  change (∃ y : Fin n, x=y ∧ y=z) ↔ _
  exact ⟨fun ⟨_,h,k⟩ => h.trans k, fun h => ⟨x,rfl,h⟩⟩

theorem distinctPreparations {n : Nat} {x z : Fin n} :
    (Quotient.mk _ (prepare x) : State (relLab n) .cell) = Quotient.mk _ (prepare z) ↔ x=z := by
  constructor
  · intro h
    let t : Test (relLab n) .empty .cell := .thenDo (detect z) .closed
    have same := congrArg (outcome t) h
    exact (exactSymbol x z).mp (same.mpr ((exactSymbol z z).mpr rfl))
  · rintro rfl; rfl

/-- Even the *whole* operational state space is identified in this model:
    two arbitrary preparations coincide exactly when their supports coincide. -/
theorem supportComplete {n : Nat} (p q : (relLab n).Proc .empty .cell) :
    equivalent (relLab n) p q ↔ ∀ z : Fin n, p () z ↔ q () z := by
  constructor
  · intro h z
    have e := h (.thenDo (detect z) .closed)
    change (∃ y : Fin n, p () y ∧ y=z) = (∃ y : Fin n, q () y ∧ y=z) at e
    constructor
    · intro hp; obtain ⟨_,hq,rfl⟩ := e.mp ⟨z,hp,rfl⟩; exact hq
    · intro hq; obtain ⟨_,hp,rfl⟩ := e.mpr ⟨z,hq,rfl⟩; exact hp
  · intro h
    have eq : p=q := by funext u z; cases u; exact propext (h z)
    rw [eq]; exact fun _ => rfl

theorem associativeWiring {n : Nat} {a b c d : Wire}
    (p : (relLab n).Proc a b) (q : (relLab n).Proc b c) (s : (relLab n).Proc c d) :
    (relLab n).after ((relLab n).after p q) s = (relLab n).after p ((relLab n).after q s) := by
  funext x z; apply propext
  exact ⟨fun ⟨v,⟨u,hp,hq⟩,hs⟩ => ⟨u,hp,v,hq,hs⟩,
    fun ⟨u,hp,v,hq,hs⟩ => ⟨v,⟨u,hp,hq⟩,hs⟩⟩

theorem interchangeWiring {n : Nat} {a b c d e f : Wire}
    (p : (relLab n).Proc a b) (q : (relLab n).Proc b c)
    (r : (relLab n).Proc d e) (s : (relLab n).Proc e f) :
    (relLab n).after ((relLab n).alongside p r) ((relLab n).alongside q s) =
    (relLab n).alongside ((relLab n).after p q) ((relLab n).after r s) := by
  funext x z; apply propext
  exact ⟨fun ⟨v,⟨hp,hr⟩,hq,hs⟩ => ⟨⟨v.1,hp,hq⟩,v.2,hr,hs⟩,
    fun ⟨⟨v,hp,hq⟩,w,hr,hs⟩ => ⟨(v,w),⟨hp,hr⟩,hq,hs⟩⟩

/-- Counterexample to the T-244 step from an anisotropic size to a
    division algebra. The unital product algebra has an everywhere
    positive squared Euclidean norm off zero and explicit zero divisors. -/
def sizeSq (z : Int × Int) := z.1*z.1+z.2*z.2
def componentProduct (x y : Int × Int) := (x.1*y.1,x.2*y.2)

theorem sizeZeroIff (x : Int × Int) : sizeSq x=0 ↔ x=(0,0) := by
  rcases x with ⟨a,b⟩
  constructor
  · intro eq; change a*a+b*b=0 at eq
    have posA := Int.sq_nonneg a
    have posB := Int.sq_nonneg b
    rw [Int.pow_succ,Int.pow_one] at posA posB
    have ha : a*a=0 := by omega
    have hb : b*b=0 := by omega
    have a0 := Int.mul_eq_zero.mp ha
    have b0 := Int.mul_eq_zero.mp hb
    simp [show a=0 by omega,show b=0 by omega]
  · intro h; rw [h]; rfl

theorem noNormComposition :
    let x : Int × Int := (1,0)
    let y : Int × Int := (0,1)
    sizeSq x=1 ∧ sizeSq y=1 ∧ componentProduct x y=(0,0) ∧
      sizeSq (componentProduct x y) ≠ sizeSq x*sizeSq y := by decide

end OperationalNetwork.Process
